# InnoForge 创研台配置文件
# 复制此文件为 .env 并填入你的值：
#   cp .env.example .env
# 所有配置也可以在设置页面中配置（http://localhost:3000/settings）

# ── AI 服务（AI 功能必需）─────────────────────────────────────
# 支持任何 OpenAI 兼容 API：智谱 GLM、DeepSeek、OpenAI、Ollama 等
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=your-api-key-here
AI_MODEL=glm-4-flash
# 专家深分析模型（创新推演/权利要求/发明创造性等高推理任务）
AI_MODEL_EXPERT=deepseek-reasoner

# ── 备用 AI 服务商（可选，主 AI 失败时自动切换）────────────────
# 最多 5 个备用服务商。格式：FALLBACK_AI_{1-5}_{URL|KEY|MODEL|NAME}
# FALLBACK_AI_1_NAME=OpenRouter
# FALLBACK_AI_1_URL=https://openrouter.ai/api/v1
# FALLBACK_AI_1_KEY=your-openrouter-key
# FALLBACK_AI_1_MODEL=google/gemini-2.0-flash-exp:free

# FALLBACK_AI_2_NAME=Google Gemini
# FALLBACK_AI_2_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# FALLBACK_AI_2_KEY=your-gemini-key
# FALLBACK_AI_2_MODEL=gemini-2.0-flash

# ── 御三家预设（可选，取消注释并填入 Key 即可使用）──────────────
# 详见 docs/plans/2026-10-02-top3-ai-integration/

# OpenAI（GPT-4o / o3 系列）
# 取消注释并将主 AI 切换为 OpenAI：
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-your-openai-key
# AI_MODEL=gpt-4o
# AI_MODEL_EXPERT=o3-mini

# Anthropic Claude（通过 OpenAI 兼容端点接入）
# Claude 已推出 OpenAI 兼容 API，可直接用现有架构接入：
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-your-anthropic-key
# AI_MODEL=claude-sonnet-4-6
# AI_MODEL_EXPERT=claude-opus-4

# Google Gemini（OpenAI 兼容端点）
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=AIzaSy-your-gemini-key
# AI_MODEL=gemini-2.0-flash
# AI_MODEL_EXPERT=gemini-2.5-pro

# ── SerpAPI（可选，用于在线专利搜索）─────────────────────────
# 在此获取密钥：https://serpapi.com/
# 在线搜索顺序：SerpAPI -> Firecrawl -> Google Patents direct -> Bing -> 本地库
SERPAPI_KEY=your-serpapi-key-here

# ── Firecrawl（可选，作为 SerpAPI 后的稳定备用搜索源）──────────
# 官方云服务默认使用 https://api.firecrawl.dev/v2
# 自部署时可改为你的 Firecrawl 服务地址
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=

# ── 服务器（可选）────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=3000
